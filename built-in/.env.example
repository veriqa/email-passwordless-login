# Copy to .env and fill in. .env is ignored by git - never commit real values.

# Password of the HTTPS certificate you export into certs/localhost.pfx (README, "Run it").
# Any value; the same one goes into the export command.
CERT_PASSWORD=

# Everything below is optional. Left empty, the letters go to the local Mailpit inbox
# (http://localhost:8025). To send real mail, set your SMTP server:
#   port 587 with SMTP_USE_SSL=false - STARTTLS; port 465 with SMTP_USE_SSL=true - implicit TLS.
#   SMTP_USERNAME and SMTP_PASSWORD are set together or not at all.
EMAIL_FROM_ADDRESS=
SMTP_HOST=
SMTP_PORT=
SMTP_USE_SSL=
SMTP_USERNAME=
SMTP_PASSWORD=
